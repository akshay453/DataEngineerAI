[{"document_id": "f548a7b9-e19c-4e23-9164-fb8e6a49e092", "filename": "sample_policy.pdf", "text": "Company Remote Work Policy\nOverview\nThis document outlines the company's remote work policy, effective January 1, 2025. All full-time\nemployees are eligible to work remotely up to 3 days per week, subject to manager approval.\nEligibility\nEmployees must have completed at least 90 days of employment before requesting remote work\nprivileges. New hires during their probationary period are required to work on-site full time.\nEquipment\nThe company will provide a laptop and a one-time stipend of $500 for home office equipment such as a\nmonitor, keyboard, and chair. Employees are responsible for maintaining a reliable internet connection.\nCore Hours\nAll remote employees must be available and responsive between 10 AM and 3 PM in their local\ntimezone, regardless of their chosen work schedule for the", "embedding": [-0.2126230150461197, 0.9098119735717773, -3.602346181869507, -0.2807236611843109, -0.3024650812149048, -0.13375815749168396, 0.16937707364559174, -0.1291390210390091, 0.571721076965332, 0.02243964374065399, -1.2392077445983887, 0.3809591233730316, -0.44246113300323486, -0.39073479175567627, 0.2850690186023712, 0.4015570878982544, 0.11279735714197159, -0.649383008480072, -0.6364539861679077, 0.3798736333847046, 0.3584226369857788, -0.689246416091919, -0.25361141562461853, -0.2312438040971756, -0.022012434899806976, 1.3069559335708618, 0.2547840476036072, -0.006514491513371468, 0.2543261647224426, -0.7874945402145386, -0.05059882998466492, 0.10606881976127625, 0.5085468292236328, -0.7916116118431091, 0.10874272137880325, -1.0332149267196655, 0.5729535818099976, -0.3732181191444397, -0.9491989016532898, 0.04193110764026642, -0.03657568618655205, -0.8175932168960571, 0.20029550790786743, -0.4768593907356262, 1.1647125482559204, -0.7727638483047485, 0.836357593536377, 0.9052430987358093, 0.5636588335037231, -0.4654242992401123, -0.08292914181947708, -0.78022599